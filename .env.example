# Copy to .env.local and fill in. Never commit real values.

# PostgreSQL. DATABASE_URL is the pooled URL used by the app; DIRECT_URL is used by migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/platform"
DIRECT_URL="postgresql://user:password@localhost:5432/platform"

# Signs sessions and derives the key that encrypts saved API keys. 32+ random characters.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Public address of the site. Used by background jobs and as the email link fallback.
SITE_URL="http://localhost:3000"

# First administrator, created by `npm run db:seed` (Phase 13 replaces this with the setup wizard).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Adapters. Leave empty to use the safe defaults (no storage, console email, memory rate limit).
STORAGE_PROVIDER=""
MAIL_PROVIDER=""
MAIL_FROM=""
# SMTP (when MAIL_PROVIDER=smtp)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
NOTIFY_EMAIL=""

# Protects /api/cron/* routes.
CRON_SECRET=""

# Optional Redis for rate limits and hot cache.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
